@page "/review"
@rendermode InteractiveAuto
@using KoalaBooks.Domain.Interfaces
@using KoalaBooks.Domain.Entities
@implements IDisposable
@inject IJournalEntryService JournalEntryService
@inject IFiscalYearService FiscalYearService
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Att granska — KoalaBooks</PageTitle>

<h1>🔍 Att granska</h1>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else
{
    <div class="toolbar" style="margin-bottom:1rem;">
        <label style="font-weight:600; color:#475569;">Räkenskapsår:</label>
        <select @bind="_selectedFiscalYearId" @bind:after="OnFilterChangedAsync" style="width:220px;">
            <option value="0">Alla räkenskapsår</option>
            @foreach (var fy in _openFiscalYears)
            {
                <option value="@fy.Id">@fy.Name (@fy.StartDate — @fy.EndDate)</option>
            }
        </select>
    </div>

    <JournalReviewSection Entries="FilteredDrafts" Accounts="_accounts" OnEntriesChanged="ReloadDraftsAsync" />
}

@code {
    private List<FiscalYear> _openFiscalYears = [];
    private List<Account> _accounts = [];
    private List<JournalEntry> _drafts = [];
    private int _selectedFiscalYearId; // 0 = "Alla räkenskapsår"
    private bool _isLoading;
    private IDisposable? _navigationRegistration;
    private bool _forcingFullReload;

    private List<JournalEntry> FilteredDrafts => _selectedFiscalYearId == 0
        ? _drafts
        : _drafts.Where(d => d.FiscalYearId == _selectedFiscalYearId).ToList();

    protected override async Task OnInitializedAsync()
    {
        // This page is the only one that runs InteractiveAuto/WebAssembly. Once its WASM circuit is
        // live, Blazor's client-side router keeps navigating to other pages inside that same circuit
        // instead of asking the server — but KoalaBooks.Client's DI container only registers the
        // services this page needs, so every other page throws or crashes the renderer outright.
        // Forcing a real full-page navigation on the way out lets the destination renegotiate its own
        // render mode fresh from the server, exactly like arriving at this page already does.
        _navigationRegistration = Navigation.RegisterLocationChangingHandler(context =>
        {
            // NavigateTo() always re-invokes this same handler, even with forceLoad: true — the guard
            // lets that second, self-triggered pass through instead of recursing forever.
            if (_forcingFullReload)
            {
                return ValueTask.CompletedTask;
            }

            if (!context.TargetLocation.Contains("/review", StringComparison.OrdinalIgnoreCase))
            {
                _forcingFullReload = true;
                context.PreventNavigation();
                Navigation.NavigateTo(context.TargetLocation, forceLoad: true);
            }
            return ValueTask.CompletedTask;
        });

        _isLoading = true;
        _openFiscalYears = await FiscalYearService.GetOpenFiscalYearsAsync();

        var accountsPerFiscalYear = await Task.WhenAll(_openFiscalYears.Select(fy => AccountService.GetAllAsync(fy.Id)));
        _accounts = accountsPerFiscalYear.SelectMany(a => a).Where(a => a.IsActive).DistinctBy(a => a.AccountNumber).ToList();

        await ReloadDraftsAsync();
        _isLoading = false;
    }

    private async Task OnFilterChangedAsync() => await ReloadDraftsAsync();

    private async Task ReloadDraftsAsync()
    {
        _drafts = await JournalEntryService.GetDraftsForOrganisationAsync();
    }

    public void Dispose() => _navigationRegistration?.Dispose();
}
