@page "/"
@using KoalaBooks.Application.Services
@using MudBlazor

<PageTitle>Översikt — KoalaBooks</PageTitle>

<h1>📊 Översikt</h1>

@if (_activeFiscalYear is null)
{
    <MudAlert Severity="Severity.Info">Inget aktivt räkenskapsår hittades. <a href="/fiscal-years">Skapa ett</a> för att komma igång.</MudAlert>
}
else
{
    <p style="color:#64748b; margin-bottom:1rem;">Räkenskapsår: <strong>@_activeFiscalYear.Name</strong> (@_activeFiscalYear.StartDate — @_activeFiscalYear.EndDate)</p>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_stats.EntryCount</div>
            <div class="stat-label">Verifikationer</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_stats.TotalDebit.ToString("N2")</div>
            <div class="stat-label">Summa debet</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_stats.TotalCredit.ToString("N2")</div>
            <div class="stat-label">Summa kredit</div>
        </div>
    </div>
}

<div class="stats-grid">
    <a href="/accounts" class="card" style="text-decoration:none; color:inherit;">
        <h3>📋 Kontoplan</h3>
        <p style="color:#64748b; margin:0;">Hantera konton och importera BAS-kontoplanen</p>
    </a>
    <a href="/journal" class="card" style="text-decoration:none; color:inherit;">
        <h3>📝 Verifikationer</h3>
        <p style="color:#64748b; margin:0;">Registrera debet- och kredittransaktioner</p>
    </a>
    <a href="/reports/trial-balance" class="card" style="text-decoration:none; color:inherit;">
        <h3>📈 Råbalans</h3>
        <p style="color:#64748b; margin:0;">Visa kontosaldon</p>
    </a>
</div>

@code {
    [Inject] private IFiscalYearService FiscalYearService { get; set; } = default!;
    [Inject] private IJournalEntryService JournalEntryService { get; set; } = default!;

    private KoalaBooks.Domain.Entities.FiscalYear? _activeFiscalYear;
    private DashboardStats _stats = new();

    protected override async Task OnInitializedAsync()
    {
        _activeFiscalYear = await FiscalYearService.GetActiveAsync();
        if (_activeFiscalYear is not null)
        {
            _stats = await JournalEntryService.GetDashboardStatsAsync(_activeFiscalYear.Id);
        }
    }
}
