@page "/journal"
@page "/journal/{EntryId:int}"
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities
@using KoalaBooks.Domain.Enums
@using MudBlazor
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Verifikationer — KoalaBooks</PageTitle>

<h1>📝 Verifikationer</h1>

@if (!_allFiscalYears.Any() && !_isLoading)
{
    <MudAlert Severity="Severity.Info">Inga räkenskapsår. <a href="/fiscal-years">Skapa ett</a> först.</MudAlert>
    return;
}

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else
{
<div class="toolbar" style="flex-wrap:wrap; gap:0.75rem;">
    <label style="font-weight:600; color:#475569;">Räkenskapsår:</label>
    <select @bind="_selectedFiscalYearId" @bind:after="OnFiscalYearChangedAsync" style="width:220px;">
        @foreach (var fy in _allFiscalYears)
        {
            <option value="@fy.Id">@fy.Name (@fy.StartDate — @fy.EndDate)</option>
        }
    </select>
    <label style="font-weight:600; color:#475569;">Period:</label>
    <select @bind="_selectedMonthStr" style="width:180px;">
        <option value="">Hela året</option>
        @foreach (var (month, label) in AvailableMonths())
        {
            <option value="@month">@label</option>
        }
    </select>
    @if (_activeFiscalYear is not null && _selectedFiscalYearId == _activeFiscalYear.Id)
    {
        <button class="btn btn-primary" @onclick="NewEntry">+ Ny verifikation</button>
    }
</div>

@if (_showForm)
{
    <div class="card">
        <h3>Ny verifikation</h3>

        <JournalEntryForm Accounts="_accounts"
                          Date="_formDate" DateChanged="d => _formDate = d"
                          Description="@_formDescription" DescriptionChanged="d => _formDescription = d"
                          Lines="_formLines"
                          IsBalancedChanged="b => _isBalanced = b" />

        <div style="margin-top:1rem; display:flex; gap:0.5rem;">
            <button class="btn btn-success" @onclick="SaveAndPost" disabled="@(!_isBalanced)">💾 Bokför</button>
            <button class="btn btn-secondary" @onclick="SaveAsDraft" disabled="@(!_isBalanced)">Spara som utkast</button>
            <button class="btn btn-secondary" @onclick="CancelForm">Avbryt</button>
        </div>
    </div>
}

@if (_isReloading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}

<table>
    <thead>
        <tr>
            <th style="width:60px;">#</th>
            <th style="width:110px;">Datum</th>
            <th>Beskrivning</th>
            <th style="width:120px;">Debet</th>
            <th style="width:120px;">Kredit</th>
            <th style="width:90px;">Status</th>
            <th style="width:40px;" title="Bilagor"></th>
            <th style="width:120px;">Åtgärder</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in FilteredEntries)
        {
            var canConvert = !entry.IsClosingEntry
                && !_linkedJournalEntryIds.Contains(entry.Id)
                && entry.Lines.Any(l => l.CreditAmount > 0 && l.Account?.AccountNumber?.StartsWith("24") == true);

            <tr>
                <td>@entry.EntryNumber</td>
                <td>@entry.Date</td>
                <td>@entry.Description</td>
                <td>@entry.Lines.Sum(l => l.DebitAmount).ToString("N2")</td>
                <td>@entry.Lines.Sum(l => l.CreditAmount).ToString("N2")</td>
                <td>
                    @if (entry.Status == JournalEntryStatus.Reversed)
                    {
                        <span style="color:#6b7280;">↩️ Återförd</span>
                    }
                    else if (entry.Status == JournalEntryStatus.Correction)
                    {
                        <span style="color:#2563eb;">🔄 Rättelse</span>
                    }
                    else if (entry.IsPosted)
                    {
                        <span style="color:#16a34a;">✅ Bokförd</span>
                    }
                    else
                    {
                        <span style="color:#f59e0b;">📝 Utkast</span>
                    }
                </td>
                <td style="text-align:center;">
                    @{ var attachCount = _attachmentCounts.GetValueOrDefault(entry.Id); }
                    <button class="btn btn-sm @(_attachmentEntryId == entry.Id ? "btn-primary" : "btn-secondary")"
                            style="padding:0.1rem 0.35rem; font-size:0.8rem;"
                            title="@(attachCount > 0 ? $"{attachCount} bilaga(or)" : "Lägg till bilaga")"
                            @onclick="() => ToggleAttachments(entry)">
                        📎@(attachCount > 0 ? attachCount.ToString() : "")
                    </button>
                </td>
                <td>
                    @if (_convertingEntryId == entry.Id)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="CancelConvert">Avbryt</button>
                    }
                    else if (entry.Status == JournalEntryStatus.Reversed)
                    {
                        <span style="color:#6b7280; font-size:0.85rem;">Återförd — inga åtgärder</span>
                    }
                    else
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                            <MudMenuItem OnClick="() => StartReversalAsync(entry)">Återför</MudMenuItem>
                            @if (canConvert)
                            {
                                <MudMenuItem OnClick="() => StartConvert(entry)">Skapa leverantörsfaktura</MudMenuItem>
                            }
                        </MudMenu>
                        @if (_linkedJournalEntryIds.Contains(entry.Id))
                        {
                            <span style="font-size:0.75rem; color:#16a34a; margin-left:0.25rem;">📄 Faktura</span>
                        }
                    }
                </td>
            </tr>

            @if (_attachmentEntryId == entry.Id)
            {
                <tr style="background:#f8fafc;">
                    <td colspan="8" style="padding:1rem;">
                        <div style="max-width:640px;">
                            <p style="margin:0 0 0.75rem; font-weight:600;">📎 Bilagor — Verifikation #@entry.EntryNumber</p>

                            @if (_attachmentError is not null)
                            {
                                <div style="color:#ef4444; margin-bottom:0.5rem; font-size:0.875rem;">@_attachmentError</div>
                            }

                            @if (_attachmentMeta.Any())
                            {
                                <table style="font-size:0.85rem; margin-bottom:1rem;">
                                    <thead>
                                        <tr>
                                            <th>Filnamn</th>
                                            <th style="width:90px; text-align:right;">Storlek</th>
                                            <th style="width:140px;">Uppladdad</th>
                                            <th style="width:80px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in _attachmentMeta)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@DocumentProvider.GetDownloadUrl(a.Id)" target="_blank" style="color:#2563eb;">@a.FileName</a>
                                                </td>
                                                <td style="text-align:right; color:#64748b;">@a.FileSizeDisplay</td>
                                                <td style="color:#64748b;">@a.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-danger"
                                                            @onclick="() => DeleteAttachmentAsync(a.Id)"
                                                            disabled="@_uploadingAttachment">🗑️</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p style="color:#94a3b8; font-style:italic; margin:0 0 0.75rem;">Inga bilagor ännu.</p>
                            }

                            <label class="btn btn-secondary" style="cursor:pointer; display:inline-block;">
                                @(_uploadingAttachment ? "Laddar upp..." : "📁 Välj fil (max 10 MB)")
                                <InputFile OnChange="UploadAttachmentAsync" style="display:none"
                                           accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.tiff,.heic,.xls,.xlsx,.csv,.txt"
                                           disabled="@_uploadingAttachment" />
                            </label>
                        </div>
                    </td>
                </tr>
            }

            @if (_convertingEntryId == entry.Id)
            {
                <tr style="background:#f0f9ff;">
                    <td colspan="8" style="padding:1rem;">
                        <div style="max-width:700px;">
                            <p style="margin:0 0 0.75rem; font-weight:600;">Skapa leverantörsfaktura</p>
                            <p style="font-size:0.8rem; color:#64748b; margin:0 0 0.75rem;">
                                Skapar en faktura kopplad till verifikation #@entry.EntryNumber — ingen ny verifikation skapas.
                            </p>

                            @if (_convertError is not null)
                            {
                                <div style="color:#ef4444; margin-bottom:0.5rem; font-size:0.875rem;">@_convertError</div>
                            }

                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 1.5rem; margin-bottom:0.75rem;">
                                <div class="form-group">
                                    <label>Leverantör <span style="color:#ef4444;">*</span></label>
                                    <input type="text" list="journal-supplier-list" @bind="_cSupplier" autocomplete="off" />
                                    <datalist id="journal-supplier-list">
                                        @foreach (var s in _knownSuppliers)
                                        {
                                            <option value="@s" />
                                        }
                                    </datalist>
                                </div>
                                <div class="form-group">
                                    <label>Fakturanummer</label>
                                    <input type="text" @bind="_cInvoiceNumber" />
                                </div>
                                <div class="form-group">
                                    <label>Fakturadatum <span style="color:#ef4444;">*</span></label>
                                    <DateInput @bind-Value="_cInvoiceDate" />
                                </div>
                                <div class="form-group">
                                    <label>Förfallodatum <span style="color:#ef4444;">*</span></label>
                                    <DateInput @bind-Value="_cDueDate" />
                                </div>
                                <div class="form-group">
                                    <label>Belopp exkl. moms <span style="color:#ef4444;">*</span></label>
                                    <input type="number" step="0.01" min="0" @bind="_cAmountExclVat" @bind:after="RecalcConvertTotal" />
                                </div>
                                <div class="form-group">
                                    <label>Momsbelopp</label>
                                    <input type="number" step="0.01" min="0" @bind="_cVatAmount" @bind:after="RecalcConvertTotal" />
                                </div>
                                <div class="form-group">
                                    <label>Totalt (inkl. moms)</label>
                                    <input type="number" readonly value="@_cTotal" style="background:#f8fafc; color:#64748b;" />
                                </div>
                                <div></div>
                                <div class="form-group" style="grid-column:1/-1;">
                                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                                        <input type="checkbox" @bind="_cIsPaid" />
                                        Markera som betald
                                    </label>
                                </div>
                                @if (_cIsPaid)
                                {
                                    <div class="form-group">
                                        <label>Betalningsdatum</label>
                                        <DateInput @bind-Value="_cPaidDate" />
                                    </div>
                                    <div></div>
                                }
                                <div class="form-group" style="grid-column:1/-1;">
                                    <label>Anteckningar</label>
                                    <input type="text" @bind="_cNotes" placeholder="Valfri kommentar" />
                                </div>
                            </div>

                            <button class="btn btn-primary" @onclick="() => ConfirmConvert(entry.Id)" disabled="@_converting">
                                @(_converting ? "Sparar..." : "Skapa faktura")
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (!FilteredEntries.Any() && !_showForm)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        @if (_entries.Any())
        {
            <span>Inga verifikationer för vald period.</span>
        }
        else
        {
            <span>Inga verifikationer ännu. @if (_activeFiscalYear is not null && _selectedFiscalYearId == _activeFiscalYear.Id) { <span>Klicka "Ny verifikation" för att skapa en.</span> }</span>
        }
    </MudAlert>
}

}

@code {
    [Parameter] public int? EntryId { get; set; }

    [Inject] private IJournalEntryService JournalEntryService { get; set; } = default!;
    [Inject] private IFiscalYearService FiscalYearService { get; set; } = default!;
    [Inject] private AccountService AccountService { get; set; } = default!;
    [Inject] private SupplierInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private DocumentService DocumentService { get; set; } = default!;
    [Inject] private IDocumentProvider DocumentProvider { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    private FiscalYear? _activeFiscalYear;
    private List<FiscalYear> _allFiscalYears = [];
    private int _selectedFiscalYearId;
    private bool _isReloading;
    private FiscalYear? _selectedFiscalYear => _allFiscalYears.FirstOrDefault(f => f.Id == _selectedFiscalYearId);
    private string _selectedMonthStr = "";
    private int? SelectedMonth => string.IsNullOrEmpty(_selectedMonthStr) ? null : int.Parse(_selectedMonthStr);
    private IEnumerable<JournalEntry> FilteredEntries =>
        SelectedMonth.HasValue
            ? _entries.Where(e => e.Date.Month == SelectedMonth.Value)
            : _entries;
    private List<Account> _accounts = [];
    private List<JournalEntry> _entries = [];
    private bool _showForm;
    private bool _isLoading;
    private DateTime _formDate = DateTime.Today;
    private string _formDescription = "";
    private List<JournalEntryForm.LineModel> _formLines = [];
    private bool _isBalanced;
    private HashSet<int> _linkedJournalEntryIds = [];

    // Attachment panel
    private int? _attachmentEntryId;
    private List<DocumentMeta> _attachmentMeta = [];
    private Dictionary<int, int> _attachmentCounts = [];
    private bool _uploadingAttachment;
    private string? _attachmentError;

    // Convert-to-invoice form
    private int? _convertingEntryId;
    private string _cSupplier = "";
    private string _cInvoiceNumber = "";
    private DateTime _cInvoiceDate = DateTime.Today;
    private DateTime _cDueDate = DateTime.Today.AddDays(30);
    private decimal _cAmountExclVat;
    private decimal _cVatAmount;
    private decimal _cTotal;
    private string _cNotes = "";
    private bool _cIsPaid = true;
    private DateTime _cPaidDate = DateTime.Today;
    private bool _converting;
    private string? _convertError;
    private List<string> _knownSuppliers = [];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _allFiscalYears = await FiscalYearService.GetAllAsync();
        _activeFiscalYear = _allFiscalYears.FirstOrDefault(f => !f.IsClosed) ?? _allFiscalYears.FirstOrDefault();
        if (!_allFiscalYears.Any())
        {
            _isLoading = false;
            return;
        }
        _selectedFiscalYearId = _activeFiscalYear?.Id ?? _allFiscalYears.First().Id;
        await LoadForSelectedYearAsync();
        _isLoading = false;
    }

    private void NewEntry()
    {
        _formDate = DateTime.Today;
        _formDescription = "";
        _formLines = [new(), new()];
        _showForm = true;
    }

    private void CancelForm() => _showForm = false;

    private async Task SaveAndPost() => await SaveEntryAsync(post: true);

    private async Task SaveAsDraft() => await SaveEntryAsync(post: false);

    private async Task SaveEntryAsync(bool post)
    {
        var entry = new JournalEntry
        {
            Date = DateOnly.FromDateTime(_formDate),
            Description = _formDescription,
            FiscalYearId = _activeFiscalYear!.Id,
            Lines = _formLines.Select(l => new JournalEntryLine
            {
                AccountId = l.AccountId,
                DebitAmount = l.DebitAmount,
                CreditAmount = l.CreditAmount
            }).ToList()
        };

        var (result, error) = await JournalEntryService.CreateAsync(entry);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        if (post)
        {
            // Create and post are separate calls with no wrapping transaction. If post fails
            // here, the entry is left as a draft — it's recoverable via the Review page, not lost.
            var postError = await JournalEntryService.PostAsync(result!.Id);
            if (postError is not null)
            {
                Snackbar.Add(postError, Severity.Error);
                return;
            }
        }

        Snackbar.Add(post
            ? $"Verifikation #{result!.EntryNumber} bokförd."
            : $"Verifikation #{result!.EntryNumber} sparad som utkast.",
            Severity.Success);
        _showForm = false;
        await ReloadEntriesAsync();
    }

    private async Task LoadForSelectedYearAsync()
    {
        _accounts = (await AccountService.GetAllAsync(_selectedFiscalYearId)).Where(a => a.IsActive).ToList();
        _entries = (await JournalEntryService.GetByFiscalYearAsync(_selectedFiscalYearId)).Where(e => e.IsPosted).ToList();
        _linkedJournalEntryIds = await InvoiceService.GetLinkedJournalEntryIdsAsync(_selectedFiscalYearId);
        _knownSuppliers = await InvoiceService.GetSuppliersAsync(_selectedFiscalYearId);
        _attachmentCounts = await DocumentService.GetCountsForJournalEntriesAsync(_entries.Select(e => e.Id));
    }

    private async Task OnFiscalYearChangedAsync()
    {
        _selectedMonthStr = "";
        _showForm = false;
        _attachmentEntryId = null;
        _attachmentMeta = [];
        _convertingEntryId = null;
        _isReloading = true;
        await LoadForSelectedYearAsync();
        _isReloading = false;
    }

    private async Task ReloadEntriesAsync()
    {
        _entries = (await JournalEntryService.GetByFiscalYearAsync(_selectedFiscalYearId)).Where(e => e.IsPosted).ToList();
        _attachmentCounts = await DocumentService.GetCountsForJournalEntriesAsync(_entries.Select(e => e.Id));
    }

    private async Task StartReversalAsync(JournalEntry entry)
    {
        var parameters = new DialogParameters<ReversalPreviewDialog>
        {
            { x => x.Entry, entry },
            { x => x.Accounts, _accounts }
        };
        var dialogRef = await DialogService.ShowAsync<ReversalPreviewDialog>(
            $"Återför verifikation #{entry.EntryNumber}", parameters, DialogDefaults.NoDismiss);
        var result = await dialogRef.Result;
        if (result is { Canceled: false } && result.Data is JournalEntry reversal)
        {
            Snackbar.Add($"Återföringsverifikation #{reversal.EntryNumber} skapad.", Severity.Success);
            await ReloadEntriesAsync();
        }
    }

    private void StartConvert(JournalEntry entry)
    {
        _convertingEntryId = entry.Id;
        _convertError = null;
        _cInvoiceDate = entry.Date.ToDateTime(TimeOnly.MinValue);
        _cDueDate = entry.Date.ToDateTime(TimeOnly.MinValue).AddDays(30);
        _cIsPaid = true;
        _cPaidDate = entry.Date.ToDateTime(TimeOnly.MinValue);
        _cNotes = "";

        // Parse supplier name and invoice number from description
        const string prefix = "Leverantörsfaktura ";
        var desc = entry.Description;
        if (desc.StartsWith(prefix))
        {
            var rest = desc[prefix.Length..];
            var hashIdx = rest.IndexOf(" #");
            _cSupplier = hashIdx >= 0 ? rest[..hashIdx] : rest;
            _cInvoiceNumber = hashIdx >= 0 ? rest[(hashIdx + 2)..] : "";
        }
        else
        {
            _cSupplier = desc;
            _cInvoiceNumber = "";
        }

        // Pre-fill amounts from lines
        var vatLine = entry.Lines.FirstOrDefault(l => l.DebitAmount > 0 && l.Account?.AccountNumber?.StartsWith("2641") == true);
        _cVatAmount = vatLine?.DebitAmount ?? 0;

        var payableLine = entry.Lines.FirstOrDefault(l => l.CreditAmount > 0 && l.Account?.AccountNumber?.StartsWith("24") == true);
        _cTotal = payableLine?.CreditAmount ?? entry.Lines.Sum(l => l.CreditAmount);
        _cAmountExclVat = _cTotal - _cVatAmount;
    }

    private void CancelConvert()
    {
        _convertingEntryId = null;
        _convertError = null;
    }

    private void RecalcConvertTotal() => _cTotal = _cAmountExclVat + _cVatAmount;

    private async Task ConfirmConvert(int entryId)
    {
        _convertError = null;
        _converting = true;
        try
        {
            var invoice = new SupplierInvoice
            {
                FiscalYearId = _selectedFiscalYearId,
                SupplierName = _cSupplier.Trim(),
                InvoiceNumber = string.IsNullOrWhiteSpace(_cInvoiceNumber) ? null : _cInvoiceNumber.Trim(),
                InvoiceDate = DateOnly.FromDateTime(_cInvoiceDate),
                DueDate = DateOnly.FromDateTime(_cDueDate),
                AmountExclVat = _cAmountExclVat,
                VatAmount = _cVatAmount,
                TotalAmount = _cTotal,
                Notes = string.IsNullOrWhiteSpace(_cNotes) ? null : _cNotes.Trim(),
                IsPaid = _cIsPaid,
                PaidDate = _cIsPaid ? DateOnly.FromDateTime(_cPaidDate) : null
            };

            var (result, error) = await InvoiceService.CreateFromEntryAsync(entryId, invoice);
            if (error is not null) { _convertError = error; return; }

            Snackbar.Add($"Faktura för {result!.SupplierName} skapad och kopplad till verifikation.", Severity.Success);
            _convertingEntryId = null;
            _entries = (await JournalEntryService.GetByFiscalYearAsync(_selectedFiscalYearId)).Where(e => e.IsPosted).ToList();
            _linkedJournalEntryIds = await InvoiceService.GetLinkedJournalEntryIdsAsync(_selectedFiscalYearId);
            _knownSuppliers = await InvoiceService.GetSuppliersAsync(_selectedFiscalYearId);
        }
        finally { _converting = false; }
    }

    private async Task ToggleAttachments(JournalEntry entry)
    {
        _attachmentError = null;
        if (_attachmentEntryId == entry.Id)
        {
            _attachmentEntryId = null;
            _attachmentMeta = [];
            return;
        }
        _attachmentEntryId = entry.Id;
        _attachmentMeta = await DocumentService.GetLinkedAsync(DocumentEntityType.JournalEntry, entry.Id);
    }

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        _uploadingAttachment = true;
        try
        {
            const long maxBytes = 10 * 1024 * 1024;
            if (e.File.Size > maxBytes)
            {
                _attachmentError = "Filen är för stor (max 10 MB).";
                return;
            }
            var contentType = string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType;
            await using var stream = e.File.OpenReadStream(maxBytes);
            var (added, uploadErr) = await DocumentService.UploadAndLinkAsync(
                e.File.Name, contentType, stream,
                DocumentEntityType.JournalEntry, _attachmentEntryId!.Value);
            if (added is null)
            {
                _attachmentError = uploadErr ?? "Uppladdning misslyckades.";
                return;
            }
            _attachmentMeta = await DocumentService.GetLinkedAsync(DocumentEntityType.JournalEntry, _attachmentEntryId.Value);
            _attachmentCounts[_attachmentEntryId.Value] = _attachmentMeta.Count;
            Snackbar.Add($"{e.File.Name} uppladdad.", Severity.Success);
        }
        catch (Exception ex)
        {
            _attachmentError = $"Uppladdning misslyckades: {ex.Message}";
        }
        finally { _uploadingAttachment = false; }
    }

    private async Task DeleteAttachmentAsync(int attachmentId)
    {
        _attachmentError = null;
        await DocumentService.DeleteAsync(attachmentId);
        _attachmentMeta = await DocumentService.GetLinkedAsync(DocumentEntityType.JournalEntry, _attachmentEntryId!.Value);
        _attachmentCounts[_attachmentEntryId.Value] = _attachmentMeta.Count;
        if (_attachmentCounts[_attachmentEntryId.Value] == 0)
            _attachmentCounts.Remove(_attachmentEntryId.Value);
    }

    private IEnumerable<(int Month, string Label)> AvailableMonths()
    {
        var fy = _selectedFiscalYear;
        if (fy is null) yield break;
        var current = new DateOnly(fy.StartDate.Year, fy.StartDate.Month, 1);
        var end = new DateOnly(fy.EndDate.Year, fy.EndDate.Month, 1);
        while (current <= end)
        {
            yield return (current.Month, current.ToString("MMMM yyyy", new CultureInfo("sv-SE")));
            current = current.AddMonths(1);
        }
    }
}
