@page "/export/sie"
@using KoalaBooks.Infrastructure.Services
@using KoalaBooks.Application.Services
@using MudBlazor
@inject SieExportService SieExportService
@inject FiscalYearService FiscalYearService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Exportera SIE — KoalaBooks</PageTitle>

<h1>📤 Exportera SIE-4-fil</h1>

@if (_fiscalYears is null)
{
    <p>Laddar räkenskapsår…</p>
}
else if (_fiscalYears.Count == 0)
{
    <p>Inga räkenskapsår hittades. Skapa ett först.</p>
}
else
{
    <div class="form-group" style="margin-bottom: 1rem;">
        <label for="fy-select"><strong>Räkenskapsår</strong></label>
        <select id="fy-select" @bind="_selectedFyId" class="form-control" style="max-width: 300px;">
            @foreach (var fy in _fiscalYears)
            {
                <option value="@fy.Id">@fy.Name (@fy.StartDate – @fy.EndDate)</option>
            }
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 1rem;">
        <label for="company-name"><strong>Företagsnamn</strong> (valfritt)</label>
        <input id="company-name" type="text" @bind="_companyName" class="form-control"
               placeholder="Lämna tomt för att använda räkenskapsårets namn" style="max-width: 300px;" />
    </div>

    <button class="btn btn-primary" @onclick="ExportAsync" disabled="@_exporting">
        @if (_exporting)
        {
            <span>Exporterar…</span>
        }
        else
        {
            <span>Exportera SIE-4</span>
        }
    </button>
}

@code {
    private List<KoalaBooks.Domain.Entities.FiscalYear>? _fiscalYears;
    private int _selectedFyId;
    private string? _companyName;
    private bool _exporting;

    protected override async Task OnInitializedAsync()
    {
        _fiscalYears = await FiscalYearService.GetAllAsync();
        if (_fiscalYears.Count > 0)
        {
            _selectedFyId = _fiscalYears[0].Id;
        }
    }

    private async Task ExportAsync()
    {
        _exporting = true;

        try
        {
            var bytes = await SieExportService.ExportAsync(_selectedFyId, string.IsNullOrWhiteSpace(_companyName) ? null : _companyName);
            var base64 = Convert.ToBase64String(bytes);
            var fy = _fiscalYears!.First(f => f.Id == _selectedFyId);
            var fileName = $"koalabooks_{fy.Name}.se";
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export misslyckades: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }
}
