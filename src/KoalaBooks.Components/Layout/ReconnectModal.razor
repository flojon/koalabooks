<script type="module" src="@Assets["_content/KoalaBooks.Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Återansluter...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Försöker fortfarande återansluta. Nästa försök om <span id="components-seconds-to-next-attempt"></span> sekunder.
        </p>
        <p class="components-reconnect-attempting-visible">
            Anslutningen förlorades.<br />Försöker återansluta...
        </p>
        <p class="components-reconnect-failed-visible">
            Det gick inte att återansluta.<br />Försök igen eller ladda om sidan.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Försök igen
        </button>
        <p class="components-reconnect-rejected-visible">
            Anslutningen förlorades.<br />Ladda om sidan för att fortsätta.
        </p>
        <button id="components-reconnect-reload-button" class="components-reconnect-rejected-visible">
            Ladda om sidan
        </button>
        <p class="components-pause-visible">
            Din session pausades av servern.
        </p>
        <p class="components-resume-failed-visible">
            Det gick inte att återuppta sessionen.<br />Försök igen eller ladda om sidan.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Återuppta
        </button>
    </div>
</dialog>
