@page "/import/sie"
@using KoalaBooks.Infrastructure.Services
@using KoalaBooks.Application.Services
@using jsiSIE
@using MudBlazor

<PageTitle>Importera SIE — KoalaBooks</PageTitle>

<h1>📥 Importera SIE-4-fil</h1>

<p style="color:#64748b;">Ladda upp en SIE-4-fil (.se / .si) för att importera räkenskapsårsdata inklusive konton, verifikationer och saldon.</p>

@if (_preview is null)
{
    <div class="card">
        <h3>Välj fil</h3>
        <div class="toolbar">
            <label class="btn btn-primary" style="margin:0;">
                📁 Välj SIE-fil
                <InputFile OnChange="HandleFileUpload" style="display:none" accept=".se,.si,.sie" />
            </label>
        </div>
        @if (_parsing)
        {
            <p style="color:#64748b; margin-top:0.5rem;">Läser fil...</p>
        }
    </div>
}
else
{
    <div class="card">
        <h3>Förhandsgranskning</h3>
        <table>
            <tbody>
                <tr><td style="font-weight:600; width:150px;">Företag</td><td>@(_preview.CompanyName ?? "—")</td></tr>
                <tr><td style="font-weight:600;">Org.nummer</td><td>@(_preview.OrgNumber ?? "—")</td></tr>
                <tr><td style="font-weight:600;">SIE-typ</td><td>@_preview.SieType</td></tr>
                <tr><td style="font-weight:600;">Konton</td><td>@_preview.AccountCount</td></tr>
                <tr><td style="font-weight:600;">Antal verifikationer</td><td>@_preview.VoucherCount</td></tr>
            </tbody>
        </table>
    </div>

    <h2>Räkenskapsår</h2>

    @foreach (var fy in _preview.FiscalYears)
    {
        <div class="card" style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
            <strong>@fy.Label</strong>
            <span style="color:#64748b;">(@fy.Start — @fy.End)</span>
            <span style="color:#64748b;">@fy.VoucherCount verifikation(er)</span>
            @if (fy.BalanceCount > 0)
            {
                <span style="color:#64748b;">@fy.BalanceCount saldo(n)</span>
            }
            @if (fy.ExistsInDatabase)
            {
                <span style="color:#f59e0b;">⚠️ Finns redan</span>
            }
        </div>
    }

    @if (_importAllResult is null)
    {
        <div style="margin-top:1rem; display:flex; gap:0.5rem; align-items:center;">
            @if (_hasExistingYears && !_confirmOverwrite)
            {
                <button class="btn btn-danger" @onclick="() => _confirmOverwrite = true" disabled="@_importing">
                    Importera (skriv över befintliga)
                </button>
            }
            else if (_confirmOverwrite)
            {
                <span style="color:#dc2626; font-weight:600;">Detta skriver över befintlig räkenskapsårsdata. Fortsätta?</span>
                <button class="btn btn-danger" @onclick="ImportAll" disabled="@_importing">Ja, importera allt</button>
                <button class="btn btn-secondary" @onclick="() => _confirmOverwrite = false">Avbryt</button>
            }
            else
            {
                <button class="btn btn-success" @onclick="ImportAll" disabled="@_importing">Importera allt</button>
            }
            @if (_importing)
            {
                <span style="color:#64748b;">Importerar...</span>
            }
        </div>
    }

    @if (_importAllResult is not null)
    {
        <div class="card" style="margin-top:1rem;">
            <h3>Importresultat</h3>
            <table>
                <tbody>
                    @foreach (var fy in _importAllResult.FiscalYears)
                    {
                        <tr>
                            <td style="font-weight:600;">@fy.FiscalYearName</td>
                            <td>@fy.AccountsCreated konto(n), @fy.EntriesImported verifikationer, @fy.BalancesImported saldo(n)</td>
                        </tr>
                    }
                    <tr style="font-weight:700; border-top:2px solid #e2e8f0;">
                        <td>Summa</td>
                        <td>@_importAllResult.TotalAccountsCreated konto(n), @_importAllResult.TotalEntriesImported verifikationer, @_importAllResult.TotalBalancesImported saldo(n)</td>
                    </tr>
                </tbody>
            </table>
            @if (_importAllResult.Warnings.Any())
            {
                <div class="alert alert-info" style="margin-top:0.5rem;">
                    <strong>Varningar:</strong>
                    <ul style="margin:0.25rem 0 0; padding-left:1.25rem;">
                        @foreach (var w in _importAllResult.Warnings.Take(20))
                        {
                            <li>@w</li>
                        }
                        @if (_importAllResult.Warnings.Count > 20)
                        {
                            <li>...och @(_importAllResult.Warnings.Count - 20) till</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    <div style="margin-top:1rem;">
        <button class="btn btn-secondary" @onclick="Reset">↩ Ladda upp en ny fil</button>
    </div>
}

@code {
    [Inject] private SieImportService SieImportService { get; set; } = default!;
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private SieDocument? _sieDocument;
    private SieImportPreview? _preview;
    private SieImportAllResult? _importAllResult;
    private bool _parsing;
    private bool _importing;
    private bool _confirmOverwrite;

    private bool _hasExistingYears => _preview?.FiscalYears.Any(f => f.ExistsInDatabase) ?? false;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        _parsing = true;
        _importAllResult = null;

        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            _sieDocument = SieImportService.Parse(stream);

            if (_sieDocument.SIETYP != 4)
            {
                Snackbar.Add($"Bara SIE typ 4 stöds. Denna fil är typ {_sieDocument.SIETYP}.", Severity.Error);
                _sieDocument = null;
                return;
            }

            _preview = await SieImportService.GetPreviewAsync(_sieDocument);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunde inte läsa SIE-fil: {ex.Message}", Severity.Error);
        }
        finally
        {
            _parsing = false;
        }
    }

    private async Task ImportAll()
    {
        _importing = true;
        _confirmOverwrite = false;

        try
        {
            _importAllResult = await SieImportService.ImportAllAsync(_sieDocument!, overwrite: _hasExistingYears);

            foreach (var fy in _importAllResult.FiscalYears)
                await FiscalYearService.PropagateBalancesToNextYearAsync(fy.FiscalYearId);

            var totalEntries = _importAllResult.TotalEntriesImported;
            var fyCount = _importAllResult.FiscalYears.Count;
            Snackbar.Add($"Importerade {fyCount} räkenskapsår med {totalEntries} verifikationer.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import misslyckades: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void Reset()
    {
        _sieDocument = null;
        _preview = null;
        _importAllResult = null;
        _confirmOverwrite = false;
    }
}
