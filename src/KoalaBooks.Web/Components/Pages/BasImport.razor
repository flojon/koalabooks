@page "/import/bas"
@using KoalaBooks.Infrastructure.Services
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities
@using MudBlazor

<PageTitle>Import BAS — KoalaBooks</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">📊 Import BAS Chart of Accounts</MudText>
<MudText Typo="Typo.body1" Style="color:#64748b;" Class="mb-4">
    Upload a BAS Excel file (.xls or .xlsx) to import a standard chart of accounts into the selected fiscal year.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_result is not null)
{
    <MudAlert Severity="@(_result.Errors.Count > 0 ? Severity.Warning : Severity.Success)" Class="mb-4">
        <MudText><strong>Import complete.</strong> @_result.ImportedCount imported, @_result.SkippedCount skipped.</MudText>
        @if (_result.Errors.Count > 0)
        {
            <ul style="margin: 0.5rem 0 0; padding-left: 1.25rem;">
                @foreach (var err in _result.Errors.Take(20))
                {
                    <li>@err</li>
                }
                @if (_result.Errors.Count > 20)
                {
                    <li>... and @(_result.Errors.Count - 20) more</li>
                }
            </ul>
        }
    </MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="Reset" Class="mb-4">↩ Import Another File</MudButton>
}

@if (_result is null)
{
    <MudCard Class="pa-4 mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Select Fiscal Year</MudText>

            @if (_fiscalYears.Count == 0)
            {
                <MudAlert Severity="Severity.Warning">No fiscal years found. Please create one first.</MudAlert>
            }
            else
            {
                <MudSelect T="int" @bind-Value="_selectedFiscalYearId" Label="Fiscal Year" Variant="Variant.Outlined" Class="mb-4" Style="max-width:400px;">
                    @foreach (var fy in _fiscalYears)
                    {
                        <MudSelectItem Value="fy.Id">@fy.Name (@fy.StartDate.Year)</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="mb-4" />

                <MudText Typo="Typo.h6" Class="mb-3">Upload BAS Excel File</MudText>
                <MudText Typo="Typo.body2" Style="color:#64748b;" Class="mb-3">
                    Supported format: BAS Kontoplan Excel (.xls, .xlsx). Example: <em>Kontoplan_K1_2018.xls</em>
                </MudText>

                <label class="btn btn-primary" style="display:inline-block; cursor:pointer;">
                    📁 Choose File
                    <InputFile OnChange="HandleFileUpload" style="display:none" accept=".xls,.xlsx" />
                </label>

                @if (_fileName is not null)
                {
                    <MudText Class="mt-2" Style="color:#64748b;">Selected: <strong>@_fileName</strong></MudText>
                }

                @if (_importing)
                {
                    <MudText Class="mt-3" Style="color:#64748b;">Importing accounts...</MudText>
                }
            }
        </MudCardContent>
    </MudCard>
}

@code {
    [Inject] private BasImportService BasImportService { get; set; } = default!;
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;

    private List<FiscalYear> _fiscalYears = [];
    private int _selectedFiscalYearId;
    private string? _fileName;
    private string? _error;
    private bool _importing;
    private BasImportResult? _result;

    protected override async Task OnInitializedAsync()
    {
        _fiscalYears = await FiscalYearService.GetAllAsync();
        var active = _fiscalYears.FirstOrDefault(f => !f.IsClosed) ?? _fiscalYears.FirstOrDefault();
        if (active is not null)
            _selectedFiscalYearId = active.Id;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        _fileName = e.File.Name;
        _importing = true;

        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            _result = await BasImportService.ImportFromExcelAsync(stream, _selectedFiscalYearId);
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private void Reset()
    {
        _fileName = null;
        _error = null;
        _result = null;
    }
}
