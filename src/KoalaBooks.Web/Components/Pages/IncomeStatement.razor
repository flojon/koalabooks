@page "/reports/income-statement"
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities

<PageTitle>Income Statement — KoalaBooks</PageTitle>

<h1>💰 Income Statement (Resultaträkning)</h1>

@if (_fiscalYears.Any())
{
    <div class="toolbar" style="flex-wrap:wrap; gap:0.75rem;">
        <label style="font-weight:600; color:#475569;">Fiscal Year:</label>
        <select @bind="SelectedFiscalYearId" style="width:200px;">
            @foreach (var fy in _fiscalYears)
            {
                <option value="@fy.Id">@fy.Name (@fy.StartDate — @fy.EndDate)</option>
            }
        </select>

        <label style="font-weight:600; color:#475569;">From Date:</label>
        <input type="date" @bind="FromDate" style="width:150px;" />

        <label style="font-weight:600; color:#475569;">To Date:</label>
        <input type="date" @bind="ToDate" style="width:150px;" />

        <button class="btn" @onclick="LoadReport">Generate</button>
    </div>

    @if (_sections is not null)
    {
        @if (!_sections.Any(s => s.Rows.Any()))
        {
            <div class="alert alert-info" style="margin-top:1rem;">No revenue or expense transactions found for the selected criteria.</div>
        }

        @foreach (var sect in _sections)
        {
            <div class="card" style="margin-top:1.5rem;">
                <h3 style="margin:0 0 0.75rem 0;">@sect.Title</h3>
                @if (sect.Rows.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th style="width:100px;">Account</th>
                                <th>Name</th>
                                <th style="width:140px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in sect.Rows)
                            {
                                <tr>
                                    <td>@row.AccountNumber</td>
                                    <td>@row.AccountName</td>
                                    <td style="text-align:right;">@row.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:700; background:#f1f5f9;">
                                <td colspan="2">Total @sect.Title</td>
                                <td style="text-align:right;">@sect.Total.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No accounts in this section.</div>
                }
            </div>
        }

        <div class="card" style="margin-top:1.5rem; text-align:center;">
            <h2 style="margin:0; color:@(_netResult >= 0 ? "#16a34a" : "#dc2626");">
                Årets resultat: @_netResult.ToString("N2") kr
            </h2>
        </div>
    }
}
else
{
    <div class="alert alert-info">No fiscal years found. <a href="/fiscal-years">Create one</a> first.</div>
}

@code {
    [Inject] private JournalEntryService JournalEntryService { get; set; } = default!;
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;

    private List<FiscalYear> _fiscalYears = [];
    private List<IncomeStatementSection>? _sections;
    private decimal _netResult;
    private int SelectedFiscalYearId { get; set; }
    private DateOnly? FromDate { get; set; }
    private DateOnly? ToDate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _fiscalYears = await FiscalYearService.GetAllAsync();
        var active = _fiscalYears.FirstOrDefault(f => !f.IsClosed) ?? _fiscalYears.FirstOrDefault();
        if (active is not null)
        {
            SelectedFiscalYearId = active.Id;
            await LoadReport();
        }
    }

    private async Task LoadReport()
    {
        var result = await JournalEntryService.GetIncomeStatementAsync(SelectedFiscalYearId, FromDate, ToDate);
        _sections = result.Sections;
        _netResult = result.NetResult;
    }
}
