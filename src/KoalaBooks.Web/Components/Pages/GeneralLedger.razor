@page "/reports/general-ledger"
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities
@using MudBlazor

<PageTitle>Huvudbok — KoalaBooks</PageTitle>

<h1>📒 Huvudbok</h1>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_fiscalYears.Any())
{
    <div class="toolbar" style="flex-wrap:wrap; gap:0.75rem;">
        <label style="font-weight:600; color:#475569;">Räkenskapsår:</label>
        <select @bind="SelectedFiscalYearId" style="width:200px;">
            @foreach (var fy in _fiscalYears)
            {
                <option value="@fy.Id">@fy.Name (@fy.StartDate — @fy.EndDate)</option>
            }
        </select>

        <label style="font-weight:600; color:#475569;">Från konto:</label>
        <input type="text" @bind="FromAccount" placeholder="t.ex. 1000" style="width:100px;" />

        <label style="font-weight:600; color:#475569;">Till konto:</label>
        <input type="text" @bind="ToAccount" placeholder="t.ex. 1999" style="width:100px;" />

        <label style="font-weight:600; color:#475569;">Från datum:</label>
        <input type="date" @bind="FromDate" style="width:150px;" />

        <label style="font-weight:600; color:#475569;">Till datum:</label>
        <input type="date" @bind="ToDate" style="width:150px;" />

        <button class="btn" @onclick="LoadReport">Generera</button>
    </div>

    @if (_sections is not null)
    {
        @if (!_sections.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">Inga konton hittades för de valda kriterierna.</MudAlert>
        }

        @foreach (var acct in _sections)
        {
            <div class="card" style="margin-top:1.5rem;">
                <h3 style="margin:0 0 0.75rem 0;">@acct.AccountNumber @acct.AccountName</h3>
                <table>
                    <thead>
                        <tr>
                            <th style="width:110px;">Datum</th>
                            <th style="width:80px;">Ver.nr</th>
                            <th>Beskrivning</th>
                            <th style="width:130px; text-align:right;">Debet</th>
                            <th style="width:130px; text-align:right;">Kredit</th>
                            <th style="width:140px; text-align:right;">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="background:#f8fafc; font-weight:600;">
                            <td colspan="5">Ingående saldo</td>
                            <td style="text-align:right;">@acct.IncomingBalance.ToString("N2")</td>
                        </tr>
                        @foreach (var row in acct.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("yyyy-MM-dd")</td>
                                <td>@row.EntryNumber</td>
                                <td>@row.Description</td>
                                <td style="text-align:right;">@(row.DebitAmount != 0 ? row.DebitAmount.ToString("N2") : "—")</td>
                                <td style="text-align:right;">@(row.CreditAmount != 0 ? row.CreditAmount.ToString("N2") : "—")</td>
                                <td style="text-align:right;">@row.RunningBalance.ToString("N2")</td>
                            </tr>
                        }
                        <tr style="background:#f1f5f9; font-weight:700;">
                            <td colspan="5">Utgående saldo</td>
                            <td style="text-align:right;">@acct.ClosingBalance.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    }
}
else
{
    <MudAlert Severity="Severity.Info">Inga räkenskapsår hittades. <a href="/fiscal-years">Skapa ett</a> först.</MudAlert>
}

@code {
    [Inject] private JournalEntryService JournalEntryService { get; set; } = default!;
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;

    private List<FiscalYear> _fiscalYears = [];
    private List<GeneralLedgerAccountSection>? _sections;
    private bool _isLoading;
    private int SelectedFiscalYearId { get; set; }
    private string? FromAccount { get; set; }
    private string? ToAccount { get; set; }
    private DateOnly? FromDate { get; set; }
    private DateOnly? ToDate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _fiscalYears = await FiscalYearService.GetAllAsync();
        var active = _fiscalYears.FirstOrDefault(f => !f.IsClosed) ?? _fiscalYears.FirstOrDefault();
        if (active is not null)
        {
            SelectedFiscalYearId = active.Id;
            await LoadReport();
        }
        _isLoading = false;
    }

    private async Task LoadReport()
    {
        _sections = await JournalEntryService.GetGeneralLedgerAsync(
            SelectedFiscalYearId, FromAccount, ToAccount, FromDate, ToDate);
    }
}
