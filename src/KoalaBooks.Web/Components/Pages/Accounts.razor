@page "/accounts"
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities
@using KoalaBooks.Domain.Enums
@using KoalaBooks.Infrastructure.Services
@using MudBlazor

<PageTitle>Chart of Accounts — KoalaBooks</PageTitle>

<h1>📋 Chart of Accounts</h1>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_activeFiscalYear is null)
{
    <MudAlert Severity="Severity.Info">No active fiscal year found. <a href="/fiscal-years">Create one</a> to manage accounts.</MudAlert>
    return;
}
else
{

<p style="color:#64748b; margin-bottom:1rem;">Fiscal Year: <strong>@_activeFiscalYear.Name</strong></p>

<div class="toolbar">
    <button class="btn btn-primary" @onclick="() => _showForm = !_showForm">
        @(_showForm ? "Cancel" : "+ Add Account")
    </button>
    <label class="btn btn-secondary" style="margin:0;">
        📁 Import CSV
        <InputFile OnChange="HandleFileUpload" style="display:none" accept=".csv" />
    </label>
</div>

@if (_showForm)
{
    <div class="card">
        <h3>@(_editingAccount is null ? "Add Account" : "Edit Account")</h3>
        <div style="display:grid; grid-template-columns:120px 1fr 200px auto; gap:0.5rem; align-items:end;">
            <div class="form-group">
                <label>Number</label>
                <input type="text" @bind="_formNumber" placeholder="1910" />
            </div>
            <div class="form-group">
                <label>Name</label>
                <input type="text" @bind="_formName" placeholder="Kassa" />
            </div>
            <div class="form-group">
                <label>Class</label>
                <select @bind="_formClass">
                    @foreach (var c in Enum.GetValues<AccountClass>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <button class="btn btn-success" @onclick="SaveAccount">Save</button>
        </div>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_formError</MudAlert>
        }
    </div>
}

<table>
    <thead>
        <tr>
            <th style="width:100px;">Number</th>
            <th>Name</th>
            <th style="width:120px;">Class</th>
            <th style="width:120px; text-align:right;">IB</th>
            <th style="width:120px; text-align:right;">UB</th>
            <th style="width:80px;">Active</th>
            <th style="width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in _accounts)
        {
            <tr style="@(account.IsActive ? "" : "opacity:0.5")">
                <td>@account.AccountNumber</td>
                <td>@account.Name</td>
                <td>@account.AccountClass</td>
                <td style="text-align:right;">@(account.IncomingBalance != 0 ? account.IncomingBalance.ToString("N2") : "—")</td>
                <td style="text-align:right;">@(account.OutgoingBalance != 0 ? account.OutgoingBalance.ToString("N2") : "—")</td>
                <td>@(account.IsActive ? "✅" : "❌")</td>
                <td>
                    <button class="btn btn-sm btn-secondary" @onclick="() => EditAccount(account)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => ToggleActive(account.Id)">
                        @(account.IsActive ? "Disable" : "Enable")
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!_accounts.Any())
{
    <MudAlert Severity="Severity.Info" Class="mt-4">No accounts yet. Import a CSV or add accounts manually.</MudAlert>
}

}

@code {
    [Inject] private AccountService AccountService { get; set; } = default!;
    [Inject] private CsvImportService CsvImportService { get; set; } = default!;
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private FiscalYear? _activeFiscalYear;
    private List<Account> _accounts = [];
    private bool _showForm;
    private bool _isLoading;
    private Account? _editingAccount;
    private string _formNumber = "";
    private string _formName = "";
    private AccountClass _formClass = AccountClass.Asset;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _activeFiscalYear = await FiscalYearService.GetActiveAsync();
        if (_activeFiscalYear is not null)
            await LoadAccounts();
        _isLoading = false;
    }

    private async Task LoadAccounts()
    {
        _accounts = await AccountService.GetAllAsync(_activeFiscalYear!.Id);
    }

    private void EditAccount(Account account)
    {
        _editingAccount = account;
        _formNumber = account.AccountNumber;
        _formName = account.Name;
        _formClass = account.AccountClass;
        _showForm = true;
    }

    private async Task SaveAccount()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formNumber) || string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Number and Name are required.";
            return;
        }

        if (_editingAccount is not null)
        {
            _editingAccount.AccountNumber = _formNumber.Trim();
            _editingAccount.Name = _formName.Trim();
            _editingAccount.AccountClass = _formClass;
            await AccountService.UpdateAsync(_editingAccount);
        }
        else
        {
            await AccountService.CreateAsync(new Account
            {
                AccountNumber = _formNumber.Trim(),
                Name = _formName.Trim(),
                AccountClass = _formClass,
                FiscalYearId = _activeFiscalYear!.Id
            });
        }

        _showForm = false;
        _editingAccount = null;
        _formNumber = "";
        _formName = "";
        await LoadAccounts();
    }

    private async Task ToggleActive(int id)
    {
        await AccountService.ToggleActiveAsync(id);
        await LoadAccounts();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await CsvImportService.ImportAccountsAsync(stream, _activeFiscalYear!.Id);
            var message = $"Import complete: {result.Created} created, {result.Updated} updated, {result.Skipped} skipped.";
            if (result.Errors.Any())
                message += " Errors: " + string.Join("; ", result.Errors.Take(5));
            Snackbar.Add(message, Severity.Success);
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }
}
