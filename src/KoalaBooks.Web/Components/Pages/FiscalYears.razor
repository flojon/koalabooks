@page "/fiscal-years"
@using KoalaBooks.Application.Services
@using KoalaBooks.Domain.Entities
@using MudBlazor

<PageTitle>Räkenskapsår — KoalaBooks</PageTitle>

<h1>📅 Räkenskapsår</h1>

<div class="toolbar">
    <button class="btn btn-primary" @onclick="() => _showForm = !_showForm">
        @(_showForm ? "Avbryt" : "+ Nytt räkenskapsår")
    </button>
</div>

@if (_showForm)
{
    <div class="card">
        <h3>Skapa räkenskapsår</h3>
        <div style="display:grid; grid-template-columns:1fr 150px 150px auto; gap:0.5rem; align-items:end;">
            <div class="form-group">
                <label>Namn</label>
                <input type="text" @bind="_formName" placeholder="t.ex. 2026" />
            </div>
            <div class="form-group">
                <label>Startdatum</label>
                <input type="date" @bind="_formStart" />
            </div>
            <div class="form-group">
                <label>Slutdatum</label>
                <input type="date" @bind="_formEnd" />
            </div>
            <button class="btn btn-success" @onclick="Create">Skapa</button>
        </div>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_formError</MudAlert>
        }
    </div>
}

<table>
    <thead>
        <tr>
            <th>Namn</th>
            <th>Start</th>
            <th>Slut</th>
            <th style="width:100px;">Status</th>
            <th style="width:160px;">Åtgärder</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fy in _fiscalYears)
        {
            <tr>
                <td>@fy.Name</td>
                <td>@fy.StartDate</td>
                <td>@fy.EndDate</td>
                <td>
                    @if (fy.IsClosed)
                    {
                        <span style="color:#dc2626;">🔒 Stängd</span>
                    }
                    else
                    {
                        <span style="color:#16a34a;">✅ Öppen</span>
                    }
                </td>
                <td>
                    @if (!fy.IsClosed)
                    {
                        <button class="btn btn-sm btn-warning" @onclick="() => StartClosing(fy.Id)">Stäng bokslut</button>
                    }
                </td>
            </tr>
            @if (_closingFiscalYearId == fy.Id)
            {
                <tr>
                    <td colspan="5">
                        <div class="card" style="margin:0.5rem 0;">
                            @if (_closingBusy)
                            {
                                <p>⏳ Laddar...</p>
                            }
                            else if (_closingPreview is not null)
                            {
                                @if (!_closingPreview.IsValid)
                                {
                                    <h4>⚠️ Kan inte stänga bokslut</h4>
                                    <ul>
                                        @foreach (var err in _closingPreview.Errors)
                                        {
                                            <li style="color:#dc2626;">@err</li>
                                        }
                                    </ul>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelClosing">Avbryt</button>
                                }
                                else
                                {
                                    <h4>📋 Förhandsvisning — Bokslut @fy.Name</h4>
                                    <div style="display:flex; gap:2rem; margin-bottom:1rem;">
                                        <span>Intäkter: <strong>@_closingPreview.TotalRevenue.ToString("N2")</strong></span>
                                        <span>Kostnader: <strong>@_closingPreview.TotalExpenses.ToString("N2")</strong></span>
                                        <span>Resultat: <strong>@_closingPreview.NetResult.ToString("N2")</strong></span>
                                    </div>
                                    @foreach (var entry in _closingPreview.Entries)
                                    {
                                        <p><strong>@entry.Description</strong></p>
                                        <table style="margin-bottom:0.5rem;">
                                            <thead>
                                                <tr>
                                                    <th>Konto</th>
                                                    <th>Namn</th>
                                                    <th style="width:120px;">Debet</th>
                                                    <th style="width:120px;">Kredit</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in entry.Lines)
                                                {
                                                    <tr>
                                                        <td>@line.AccountNumber</td>
                                                        <td>@line.AccountName</td>
                                                        <td>@(line.Debit != 0 ? line.Debit.ToString("N2") : "")</td>
                                                        <td>@(line.Credit != 0 ? line.Credit.ToString("N2") : "")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    <div style="margin-top:1rem; display:flex; gap:0.5rem;">
                                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmClosing(fy.Id)">✅ Bekräfta och stäng</button>
                                        <button class="btn btn-sm btn-secondary" @onclick="CancelClosing">Avbryt</button>
                                    </div>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (!_fiscalYears.Any())
{
    <MudAlert Severity="Severity.Info" Class="mt-4">Inga räkenskapsår skapade ännu.</MudAlert>
}

@code {
    [Inject] private FiscalYearService FiscalYearService { get; set; } = default!;
    [Inject] private YearEndClosingService YearEndClosingService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private List<FiscalYear> _fiscalYears = [];
    private bool _showForm;
    private string _formName = "";
    private DateTime _formStart = new(DateTime.Today.Year, 1, 1);
    private DateTime _formEnd = new(DateTime.Today.Year, 12, 31);
    private string? _formError;

    // Closing flow state
    private int? _closingFiscalYearId;
    private ClosingPreview? _closingPreview;
    private bool _closingBusy;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _fiscalYears = await FiscalYearService.GetAllAsync();
    }

    private async Task Create()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Namn är obligatoriskt.";
            return;
        }
        if (_formStart >= _formEnd)
        {
            _formError = "Startdatum måste vara före slutdatum.";
            return;
        }

        await FiscalYearService.CreateAsync(new FiscalYear
        {
            Name = _formName.Trim(),
            StartDate = DateOnly.FromDateTime(_formStart),
            EndDate = DateOnly.FromDateTime(_formEnd)
        });

        _showForm = false;
        _formName = "";
        _formError = null;
        await Load();
    }

    private async Task StartClosing(int fiscalYearId)
    {
        _closingFiscalYearId = fiscalYearId;
        _closingBusy = true;
        _closingPreview = await YearEndClosingService.PreviewClosingAsync(fiscalYearId);
        _closingBusy = false;
    }

    private void CancelClosing()
    {
        _closingFiscalYearId = null;
        _closingPreview = null;
    }

    private async Task ConfirmClosing(int fiscalYearId)
    {
        _closingBusy = true;
        var result = await YearEndClosingService.ExecuteClosingAsync(fiscalYearId);
        _closingBusy = false;

        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Bokslut misslyckades.", Severity.Error);
            _closingFiscalYearId = null;
            _closingPreview = null;
            return;
        }

        var entries = new List<string>();
        if (result.ClosingEntry1Number is not null) entries.Add($"#{result.ClosingEntry1Number}");
        if (result.ClosingEntry2Number is not null) entries.Add($"#{result.ClosingEntry2Number}");
        Snackbar.Add($"Bokslutet är klart! Bokslutsverifikationer: {string.Join(", ", entries)}", Severity.Success);

        _closingFiscalYearId = null;
        _closingPreview = null;
        await Load();
    }
}
