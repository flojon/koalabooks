@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Secondary">
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        </MudHidden>
        <MudText Typo="Typo.h6" Class="ml-2">🐨 KoalaBooks</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2" Style="color:#CBD5E1;">@context.User.Identity?.Name</MudText>
                <form method="post" action="/account/logout" style="display:inline;">
                    <AntiforgeryToken />
                    <MudIconButton Icon="@Icons.Material.Outlined.Logout" Color="Color.Inherit" Size="Size.Small"
                                   title="Logga ut" ButtonType="ButtonType.Submit" />
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Översikt</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Transaktioner</MudText>

            <MudNavLink Href="/todo" Icon="@Icons.Material.Outlined.CheckCircle">Att göra</MudNavLink>
            <MudNavLink Href="/journal" Icon="@Icons.Material.Outlined.MenuBook">Journal</MudNavLink>
            <MudNavLink Href="/supplier-invoices" Icon="@Icons.Material.Outlined.Receipt">Leverantörsfakturor</MudNavLink>
            <MudNavLink Href="/customer-invoices" Icon="@Icons.Material.Outlined.RequestPage">Kundfakturor</MudNavLink>
            <MudNavLink Href="/customers" Icon="@Icons.Material.Outlined.People">Kunder</MudNavLink>
            <MudNavLink Href="/accounts" Icon="@Icons.Material.Outlined.AccountTree">Konton</MudNavLink>
            <MudNavLink Href="/fiscal-years" Icon="@Icons.Material.Outlined.CalendarMonth">Räkenskapsår</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Rapporter</MudText>

            <MudNavLink Href="/reports/trial-balance" Icon="@Icons.Material.Outlined.BarChart">Råbalans</MudNavLink>
            <MudNavLink Href="/reports/general-ledger" Icon="@Icons.Material.Outlined.Book">Huvudbok</MudNavLink>
            <MudNavLink Href="/reports/income-statement" Icon="@Icons.Material.Outlined.TrendingUp">Resultaträkning</MudNavLink>
            <MudNavLink Href="/reports/balance-sheet" Icon="@Icons.Material.Outlined.AccountBalance">Balansräkning</MudNavLink>
            <MudNavLink Href="/reports/vat" Icon="@Icons.Material.Outlined.Receipt">Momsredovisning</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Data</MudText>

            <MudNavLink Href="/import/sie" Icon="@Icons.Material.Outlined.FileUpload">Importera SIE</MudNavLink>
            <MudNavLink Href="/import/bank" Icon="@Icons.Material.Outlined.AccountBalance">Bankimport</MudNavLink>
            <MudNavLink Href="/import/tax" Icon="@Icons.Material.Outlined.Receipt">Skattekontoimport</MudNavLink>
            <MudNavLink Href="/export/sie" Icon="@Icons.Material.Outlined.FileDownload">Exportera SIE</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" style="margin:2rem;">
                        <h3>😵 Något gick fel</h3>
                        <p>Ett oväntat fel inträffade. Försök igen.</p>
                        <button class="btn btn-primary" @onclick="Recover">🔄 Försök igen</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ett ohanterat fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override void OnParametersSet()
    {
        // Auto-recover ErrorBoundary on navigation so menu links keep working after a crash
        _errorBoundary?.Recover();
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }
}
