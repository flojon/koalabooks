@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Secondary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">🐨 KoalaBooks</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Style="color: #f8fafc;">🐨 KoalaBooks</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Transactions</MudText>

            <MudNavLink Href="/journal" Icon="@Icons.Material.Outlined.MenuBook">Journal</MudNavLink>
            <MudNavLink Href="/accounts" Icon="@Icons.Material.Outlined.AccountTree">Accounts</MudNavLink>
            <MudNavLink Href="/fiscal-years" Icon="@Icons.Material.Outlined.CalendarMonth">Fiscal Years</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Reports</MudText>

            <MudNavLink Href="/reports/trial-balance" Icon="@Icons.Material.Outlined.BarChart">Trial Balance</MudNavLink>
            <MudNavLink Href="/reports/general-ledger" Icon="@Icons.Material.Outlined.Book">General Ledger</MudNavLink>
            <MudNavLink Href="/reports/income-statement" Icon="@Icons.Material.Outlined.TrendingUp">Income Statement</MudNavLink>
            <MudNavLink Href="/reports/balance-sheet" Icon="@Icons.Material.Outlined.AccountBalance">Balance Sheet</MudNavLink>

            <MudDivider Class="my-1" />
            <MudText Typo="Typo.caption" Class="px-4 py-1" Style="color: #94A3B8; text-transform: uppercase; letter-spacing: 0.08em;">Data</MudText>

            <MudNavLink Href="/import/sie" Icon="@Icons.Material.Outlined.FileUpload">Import SIE</MudNavLink>
            <MudNavLink Href="/export/sie" Icon="@Icons.Material.Outlined.FileDownload">Export SIE</MudNavLink>
            <MudNavLink Href="/import/bas" Icon="@Icons.Material.Outlined.TableChart">Import BAS</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" style="margin:2rem;">
                        <h3>😵 Something went wrong</h3>
                        <p>An unexpected error occurred. Please try again.</p>
                        <button class="btn btn-primary" @onclick="Recover">🔄 Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void Recover()
    {
        _errorBoundary?.Recover();
    }
}
