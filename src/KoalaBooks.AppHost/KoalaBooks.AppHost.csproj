<!-- Keep this version in sync with the Aspire.Hosting.* PackageReference versions below.
     Dependabot's "microsoft-aspire" group bumps those but can't touch this Sdk attribute,
     and a mismatch makes DCP hang for 20s per resource and `aspire run` fail to start (#222). -->
<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <ItemGroup>
    <ProjectReference Include="..\KoalaBooks.Web\KoalaBooks.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>07433eab-c20b-4d7b-9434-d3f25377e198</UserSecretsId>
  </PropertyGroup>

</Project>
