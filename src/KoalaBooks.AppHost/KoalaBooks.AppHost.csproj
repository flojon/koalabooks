<!-- Keep this version in sync with the Aspire.Hosting.* PackageReference versions below;
     a mismatch makes DCP hang for 20s per resource and `aspire run` fail to start.
     Bumped together by the aspire-update.yml workflow via `aspire update` - Dependabot
     is configured to leave Aspire.Hosting.* alone so it can't reintroduce the drift. -->
<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <ItemGroup>
    <ProjectReference Include="..\KoalaBooks.Web\KoalaBooks.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>07433eab-c20b-4d7b-9434-d3f25377e198</UserSecretsId>
  </PropertyGroup>

</Project>
